<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidGroupList">
        <activity
            android:name=".ui.engine.EngineDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.compose.ComposeDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.core.CoreDemoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.delegate.DelegateDemoActivity"
            android:exported="false" />
        <!-- debug-only repro harness, adb-launched: am start -n .../.ui.debug.AutoReproActivity -->
        <activity
            android:name=".ui.debug.AutoReproActivity"
            android:exported="true" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
